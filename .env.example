# ============================================
# Nimbo ERP - Environment Configuration
# ============================================
# COPY este archivo como .env y completa los valores

# Obligatorio en producción: Clave secreta para firmar JWT
# Genera una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""

# Obligatorio: API Key de Google Gemini AI
GEMINI_API_KEY=""

# Puerto del servidor (default: 3000)
PORT=3000

# URL pública de la aplicación (para CORS, callbacks OAuth, etc.)
APP_URL="http://localhost:3000"

# NODE_ENV: "development" o "production"
NODE_ENV="development"

# ============================================
# Email SMTP (reset de contraseña, recordatorios de suscripción, tickets)
# Ejemplo con Gmail:
# - Activa la verificación en 2 pasos y genera una "contraseña de aplicación"
#   en https://myaccount.google.com/apppasswords
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="tu-correo@gmail.com"
# SMTP_PASS="contraseña-de-aplicación-de-16-caracteres"
# SMTP_FROM="tu-correo@gmail.com"
# SMTP_SECURE="false"   # true si usas puerto 465
